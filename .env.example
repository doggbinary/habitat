# Copy to .env.production.local on the Mac that builds the iPad app.
# RevenueCat > Project > API keys > the public iOS key (starts with appl_).
# Without it the app still runs, and Export shows the Pro screen with the
# store marked unavailable.
VITE_REVENUECAT_IOS_KEY=

# AI Extract's vision model (optional). Put these in .env.local (never
# committed) or the shell environment on the computer running `npm run dev`
# or `npm run full`: the local server keeps the key and the page never sees
# it. The website and the iPad app take a key in AI Extract > Model settings.
# Without any key, recognised RPG Maker sheets and pixel analysis still work.
# HABITAT_VISION_PROVIDER=openai   # openai | anthropic | gemini | openai-compatible
# HABITAT_VISION_MODEL=gpt-4.1     # defaults: gpt-4.1, claude-sonnet-4-5, gemini-2.5-pro
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# HABITAT_VISION_BASE_URL=         # only for openai-compatible endpoints
