{
  "name": "pixel-fusion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Touch-first tilemap editor for iPad and Apple Pencil",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "sync:ios": "npm run build && cap sync ios",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  }
}
