{
  "name": "habitat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Touch-first tilemap editor for iPad and Apple Pencil",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "full": "vite build && vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build:native": "npm run build && node scripts/strip-web-library.mjs",
    "sync:ios": "npm run build:native && cap sync ios",
    "icons": "node scripts/make-icons.mjs",
    "app-icon": "node scripts/make-app-icon.mjs",
    "sample-village": "node scripts/make-sample-village.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^13.7.6"
  }
}
